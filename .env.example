# ===== PYTHON BACKEND API KEYS =====
# Keep every secret API key server-side. Never prefix secrets with VITE_.
HF_TOKEN=hf_YOUR_TOKEN_HERE
GROQ_API_KEY=gsk_YOUR_KEY_HERE
MAGIC_HOUR_API_KEY=mhk_live_YOUR_KEY_HERE
PIXVERSE_API_KEY=sk-YOUR_KEY_HERE
JSON2VIDEO_API_KEY=YOUR_KEY_HERE
REWIND_API_KEY=sk-rewind-YOUR_KEY_HERE
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_KEY_HERE
KLING_API_KEY=YOUR_KEY_HERE
NGROK_VIDEO_URL=

# ===== APP AUTH =====
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ===== SUPABASE PRODUCTION =====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend-only. NEVER expose this as VITE_. Use the Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Browser/public values may remain available to the frontend when needed.
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# ===== PAYSTACK PRODUCTION =====
# Backend-only secret. Never put this in VITE_ variables or frontend code.
PAYSTACK_SECRET_KEY=sk_test_YOUR_KEY_HERE
PAYSTACK_CURRENCY=USD
# Full public frontend URL, e.g. https://your-app.example.com
PUBLIC_APP_URL=https://YOUR_PUBLIC_APP_URL

# ===== MODAL CLOUD GPU =====
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ===== TTS (Edge TTS - free, no key needed) =====
# No configuration required
