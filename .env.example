# AI Video Generator — Environment Variables
# Copy this to .env and fill in your API keys

# Hugging Face (optional — used for image generation)
HF_TOKEN=

# Groq AI (for script generation — get free key at console.groq.com)
GROQ_API_KEY=

# Magic Hour AI (for AI video generation — get key at magichour.ai)
MAGIC_HOUR_API_KEY=

# PixVerse AI (for video generation)
PIXVERSE_API_KEY=

# JSON2Video (for cinematic video rendering)
JSON2VIDEO_API_KEY=

# Rewind AI (for video generation)
REWIND_API_KEY=

# OpenRouter (for video generation — get key at openrouter.ai)
OPENROUTER_API_KEY=

# Kaggle Ngrok tunnel (for external video generation)
NGROK_VIDEO_URL=https://anew-jigsaw-fancy.ngrok-free.dev/generate-video
