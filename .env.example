# ===== PYTHON BACKEND API KEYS =====
# Keep all secret API keys server-side. Never prefix these with VITE_.
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Get from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# Get from: https://magichour.ai
MAGIC_HOUR_API_KEY=mhk_live_YOUR_KEY_HERE

# Get from: https://pixverse.ai
PIXVERSE_API_KEY=sk-YOUR_KEY_HERE

# Get from: https://json2video.com
JSON2VIDEO_API_KEY=YOUR_KEY_HERE

# Get from: https://rewind.ai
REWIND_API_KEY=sk-rewind-YOUR_KEY_HERE

# Get from: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Get from: https://aistudio.google.com
GEMINI_API_KEY=YOUR_KEY_HERE

# Optional direct Kling integration
KLING_API_KEY=YOUR_KEY_HERE

# Optional external/local video tunnel
NGROK_VIDEO_URL=

# ===== APP AUTH =====
# REQUIRED in production. Generate a long random value and keep it server-side.
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ===== SUPABASE =====
# The browser may use only the public/publishable key.
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backward-compatible alias used by bolt-ui/src/lib/supabase.ts
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# ===== MODAL CLOUD GPU =====
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ===== TTS (Edge TTS - free, no key needed) =====
# No configuration required
